# NARMIS SUPABASE CONFIGURATION
# Obtain these from your Supabase Project Settings -> API
# Note: For hackathon and demo evaluation, NARMIS provides an automatic
# resilient local data store if these variables are empty.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# OPTIONAL: GOOGLE GEMINI AI ASSISTANT
# Add your Gemini API key to enable live generative AI responses in Sage Chatbot.
# If omitted, NARMIS uses its built-in smart contextual AI engine seamlessly.
VITE_GEMINI_API_KEY=your-gemini-api-key
